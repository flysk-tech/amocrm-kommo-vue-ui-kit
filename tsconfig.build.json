{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/tests/**/*",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "tests/**/*",
    "playground/**/*",
    "docs/**/*",
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "composite": false,
    "tsBuildInfoFile": null,
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false
  }
}