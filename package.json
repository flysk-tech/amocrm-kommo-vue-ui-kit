{
  "name": "@flysk-tech/amocrm-kommo-vue-ui-kit",
  "description": "Ready-to-use Vue 3 components which implements amoCRM design",
  "version": "0.0.4",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./theme": "./dist/styles/theme.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "amocrm",
    "design-system",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vue-tsc -p tsconfig.build.json --noEmit && vite build",
    "build:watch": "vite build --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "./scripts/generate_env.docker.sh && docker compose --env-file=./.env.docker up --abort-on-container-exit",
    "test:e2e:update-snapshots": "./scripts/generate_env.docker.sh -u && docker compose --env-file=./.env.docker up --abort-on-container-exit",
    "test:e2e:ci": "playwright test --config playwright-ct.config.ts",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --build --force",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@playwright/experimental-ct-vue": "1.47.0",
    "@playwright/test": "1.47.0",
    "@storybook/addon-a11y": "^9.1.8",
    "@storybook/addon-docs": "^9.1.8",
    "@storybook/addon-links": "^9.1.8",
    "@storybook/addon-themes": "^9.1.8",
    "@storybook/addon-vitest": "^9.1.8",
    "@storybook/vue3-vite": "^9.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "css": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-storybook": "^9.1.8",
    "eslint-plugin-vue": "^9.0.0",
    "husky": "^9.0.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.70.0",
    "storybook": "^9.1.8",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^2.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "nanoid": "^5.0.0"
  },
  "lint-staged": {
    "*.{vue,js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flysk-tech/amocrm-kommo-vue-ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/flysk-tech/amocrm-kommo-vue-ui-kit/issues"
  },
  "homepage": "https://github.com/flysk-tech/amocrm-kommo-vue-ui-kit#readme",
  "license": "MIT",
  "author": "Flysk LLC",
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
